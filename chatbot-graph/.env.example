# BLHS Graph Chatbot v2 — Neo4j Aura RIENG (instance #2)
# Deploy: Railway https://lexbot-production-bb10.up.railway.app
# Source code tham chieu: blhs_graph_chatbot_full_upgrade_v1/backend
#
# KHONG dung chung NEO4J_URI / NEO4J_DATABASE voi LexBot RAG v1 (chatbot/.env).
# Hai Aura instance doc lap — tranh ghi de du lieu graph schema khac nhau.

# ----- Neo4j Aura #2 — Graph v2 -----
NEO4J_URI=neo4j+s://yyyy-graph.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_graph_v2
# Ten database tren Aura #2 — PHAI khop voi database da tao/import tren instance nay
# (Neu Aura chi co 1 DB, thuong la neo4j; neu tao DB moi thi dat ten tuong ung)
NEO4J_DATABASE=blhsgraph

# ----- OpenAI -----
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-4.1-mini

# ----- Tinh nang tuy chon -----
USE_LLM_FACT_EXTRACTOR=false
USE_VECTOR_SEARCH=false
USE_RERANKER=false
USE_HYDE=false

EMBEDDING_MODEL=bkai-foundation-models/vietnamese-bi-encoder
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=*

# Railway: dat TAT CA bien tren vao tab Variables cua service Graph v2.
# Dong bo NEO4J_DATABASE voi backend/.env -> NEO4J_GRAPH_V2_DATABASE (metadata UI).
