URL_MONGODB=mongodb://127.0.0.1:27017
SECRET_KEY=doi-khi-trien-khai-that

# ── Microservice chatbot (URL HTTP — KHÔNG phải Neo4j) ──
# LexBot backend chỉ forward HTTP; Neo4j cấu hình trên từng service chatbot.

# Chatbot RAG v1 (service gốc trong repo DATN /chatbot)
CHATBOT_SERVICE_URL=http://127.0.0.1:8001

# Chatbot BLHS Graph v2 Agentic RAG (Railway). LexBot API sẽ proxy tới:
#   POST ${CHATBOT_GRAPH_V2_URL}/api/agentic-rag/query
CHATBOT_GRAPH_V2_URL=https://<graph-rag-agentic-service>.up.railway.app

CHATBOT_TIMEOUT_SECONDS=120
CHATBOT_CONNECT_TIMEOUT_SECONDS=45

# Frontend origins production/local được phép gọi backend này.
CORS_ORIGINS=https://lex-bot-datn.vercel.app,http://localhost:5173

# ── Metadata Neo4j (chỉ để hiển thị trên UI /chat/providers — KHÔNG kết nối DB) ──
# Mỗi chatbot dùng 1 Neo4j Aura instance RIÊNG + database RIÊNG.
# Credential thật đặt trên deploy của từng service (xem chatbot/.env và chatbot-graph/.env.example).

# Aura instance #1 — LexBot RAG v1
NEO4J_RAG_V1_URI_HINT=xxxx-rag.databases.neo4j.io
NEO4J_RAG_V1_DATABASE=neo4j

# Aura instance #2 — BLHS Graph v2 (Railway)
NEO4J_GRAPH_V2_URI_HINT=yyyy-graph.databases.neo4j.io
NEO4J_GRAPH_V2_DATABASE=blhsgraph
