# BLHS Graph Chatbot v2 — Neo4j Aura instance RIENG (khong dung chung voi RAG v1)
NEO4J_URI=neo4j+s://yyyy-graph.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_graph_v2
# Ten database tren Aura #2 — bat buoc khop voi DB da import graph BLHS
NEO4J_DATABASE=blhsgraph
NEO4J_CONNECTION_TIMEOUT=10
NEO4J_QUERY_TIMEOUT=15

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

USE_LLM_FACT_EXTRACTOR=false
USE_LLM_INPUT_UNDERSTANDING=true
USE_PROVISIONAL_NEO4J_ANALYSIS=true
USE_VECTOR_SEARCH=false
USE_RERANKER=false
USE_HYDE=false

EMBEDDING_MODEL=bkai-foundation-models/vietnamese-bi-encoder
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=*
