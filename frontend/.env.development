# Dev: không đặt VITE_API_BASE → gọi relative (/chat/...) và Vite proxy sang backend :8000.
# Chạy backend: trong thư mục backend → python -m uvicorn main:app --reload --host 127.0.0.1 --port 8000
# Hoặc chạy backend/run-local.bat
#
# Nếu muốn bỏ proxy, gọi thẳng API:
# VITE_API_BASE=http://127.0.0.1:8000
